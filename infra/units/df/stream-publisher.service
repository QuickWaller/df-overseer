# df-overseer stream page publisher (infra/stream-publisher.service.example, deployed 2026-10-01)
[Unit]
Description=df-overseer stream page publisher (triggered by stream-publisher.timer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=df
Group=df
WorkingDirectory=/opt/df/dfmcp-smoke
EnvironmentFile=/etc/stream-publisher/env
ExecStart=/opt/df/dfmcp-smoke/.venv/bin/python /opt/df/dfmcp-smoke/scripts/stream_publisher.py --once
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/df/dfmcp-smoke
ReadOnlyPaths=/var/lib/dfmcp
StateDirectory=stream-publisher
