# Copy to `.env` in the repo root and fill in. infra/local.* is gitignored.
# This repo is PUBLIC — never commit real values.

# Proxmox host on the tailnet (e.g. pve-host.tailXXXX.ts.net or 100.x.y.z)
PVE_HOST=
PVE_PORT=8006

# Node name as Proxmox knows it (`pvesh get /nodes`)
PVE_NODE=

# API token. Format: user@realm!tokenid. This project's is
# svc-<project>-sandbox@pve!build. The secret is shown ONCE at creation and
# no automation may copy it; paste it here by hand.
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=

# Resource pool the token is scoped to, named <project>-sandbox by
# convention. It must not be able to see anything outside this pool.
# Required: pve.py raises on startup if unset, rather than defaulting to a
# pool that may no longer exist and failing later in a way that reads like a
# permissions error.
PVE_POOL=

# Storage backing the DF VM's disk and snapshots, dedicated to this project's
# pool so it shares no ACL boundary with any other project's disks.
# Required, for the same reason as PVE_POOL above.
PVE_STORAGE=

# VMID of the Dwarf Fortress VM, once created
DF_VMID=

# The address the DF VM is assigned at clone time (scripts/provision_vm.py
# clone writes it into ipconfig0). Must be CIDR, e.g. 192.168.1.240/24, and
# outside your router's DHCP pool. Required for `clone`; also the address
# scripts/install_df.py SSHes to, in preference to asking the guest agent.
DF_VM_IP=

# Optional. Gateway for the address above; defaults to .1 of the same /24,
# which is right on essentially every home network and wrong loudly rather
# than silently if it is not.
DF_GW=

# Optional. Nameserver for the address above; defaults to DF_GW. A statically
# addressed guest is not handed a resolver the way a DHCP one is, so without
# this the guest boots with no DNS and the first apt-get fails in a way that
# reads as a network fault rather than a missing setting.
DF_DNS=

# Cloud-init user on the DF VM; the account DF runs as and the one
# scripts/install_df.py SSHes in as. Defaults to 'df'.
DF_CIUSER=df

# Proxmox uses a self-signed cert by default. Set to the CA path if you
# have one, or "false" to skip verification (tailnet-only, acceptable).
PVE_TLS_VERIFY=false

# SSH keypair used for the DF VM. Paths only — never paste key material here.
# Generate a dedicated one:
#   ssh-keygen -t ed25519 -f ~/.ssh/df_overseer_ed25519 -N "" -C "df-overseer"
# On Windows, `chmod 600` is a no-op on NTFS; restrict it with:
#   icacls <path> /inheritance:r /grant:r "$(whoami):R"
DF_SSH_KEY=
DF_SSH_PUBKEY=

# NOTE: this file is behind the live .env in several places (DF_VNC_PASSWORD,
# the RELAY_* keys, ANTHROPIC_API_KEY) — flagged as drift, not backfilled
# wholesale here; the entry below is the one this task actually added.

# Cloudflare Tunnel connector token (scripts/provision_relay.py's
# 'cloudflared' subcommand), from the Zero Trust dashboard: Networks ->
# Tunnels -> create a tunnel -> copy the connector token shown for the
# dashboard-managed (token-based) install flow. Leave blank until you have
# one — 'cloudflared' installs fine without it and only skips the
# 'service install' step.
CLOUDFLARE_TUNNEL_TOKEN=
