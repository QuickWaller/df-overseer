# Copy to `.env` in the repo root and fill in. infra/local.* is gitignored.
# This repo is PUBLIC — never commit real values.

# Proxmox host on the tailnet (e.g. pve-host.tailXXXX.ts.net or 100.x.y.z)
PVE_HOST=
PVE_PORT=8006

# Node name as Proxmox knows it (`pvesh get /nodes`)
PVE_NODE=

# API token. Format: user@realm!tokenid. This project's is
# svc-<project>-sandbox@pve!build. The secret is shown ONCE at creation and
# no automation may copy it; paste it here by hand.
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=

# Resource pool the token is scoped to, named <project>-sandbox by
# convention. It must not be able to see anything outside this pool.
# Required: pve.py raises on startup if unset, rather than defaulting to a
# pool that may no longer exist and failing later in a way that reads like a
# permissions error.
PVE_POOL=

# Storage backing the DF VM's disk and snapshots, dedicated to this project's
# pool so it shares no ACL boundary with any other project's disks.
# Required, for the same reason as PVE_POOL above.
PVE_STORAGE=

# VMID of the Dwarf Fortress VM, once created
DF_VMID=

# The address the DF VM is assigned at clone time (scripts/provision_vm.py
# clone writes it into ipconfig0). Must be CIDR, e.g. 192.168.1.240/24, and
# outside your router's DHCP pool. Required for `clone`; also the address
# scripts/install_df.py SSHes to, in preference to asking the guest agent.
DF_VM_IP=

# Optional. Gateway for the address above; defaults to .1 of the same /24,
# which is right on essentially every home network and wrong loudly rather
# than silently if it is not.
DF_GW=

# Optional. Nameserver for the address above; defaults to DF_GW. A statically
# addressed guest is not handed a resolver the way a DHCP one is, so without
# this the guest boots with no DNS and the first apt-get fails in a way that
# reads as a network fault rather than a missing setting.
DF_DNS=

# Cloud-init user on the DF VM; the account DF runs as and the one
# scripts/install_df.py SSHes in as. Defaults to 'df'.
DF_CIUSER=df

# Proxmox uses a self-signed cert by default. Set to the CA path if you
# have one, or "false" to skip verification (tailnet-only, acceptable).
PVE_TLS_VERIFY=false

# SSH keypair used for the DF VM. Paths only — never paste key material here.
# Generate a dedicated one:
#   ssh-keygen -t ed25519 -f ~/.ssh/df_overseer_ed25519 -N "" -C "df-overseer"
# On Windows, `chmod 600` is a no-op on NTFS; restrict it with:
#   icacls <path> /inheritance:r /grant:r "$(whoami):R"
DF_SSH_KEY=
DF_SSH_PUBKEY=

# NOTE: the drift this file used to flag (DF_VNC_PASSWORD, the RELAY_* keys,
# ANTHROPIC_API_KEY) is backfilled as of 2026-09-12, along with the other keys
# a diff against the live .env found missing. Verified by comparing key NAMES
# only, never values. If you add a key to .env, add an empty counterpart here.

# Cloudflare Tunnel connector token (scripts/provision_relay.py's
# 'cloudflared' subcommand), from the Zero Trust dashboard: Networks ->
# Tunnels -> create a tunnel -> copy the connector token shown for the
# dashboard-managed (token-based) install flow. Leave blank until you have
# one — 'cloudflared' installs fine without it and only skips the
# 'service install' step.
CLOUDFLARE_TUNNEL_TOKEN=

# --- openclaw agent-host VM (planned, not yet provisioned) ---------------
# The address for the VM that runs `openclaw`, the agent host that drives the
# fortress. It lives on its own VM rather than sharing the relay, because it
# holds provider API credentials and write authority over the fort while the
# relay is the most exposed surface in the estate. See
# docs/AGENT-ARCHITECTURE.md section 13 for the topology and why the MCP
# server stays on the DF VM instead.
#
# Must be CIDR, and assigned statically via ipconfig0 at clone time rather
# than through a MAC-keyed DHCP reservation: these sandbox VMs do not hold a
# constant MAC across rebuilds, so a MAC-keyed reservation would not survive
# one. Allocate the address in home-lab/inventory/ips.yaml BEFORE assigning
# it; that file is an allocation registry, consult-before-assign.
OPENCLAW_VM_IP=

# The agent host's vmid, set once the clone exists. Pass the address to
# `provision_vm.py clone` with --ip-var OPENCLAW_VM_IP: the default is
# DF_VM_IP, which is the running fort, and cloning onto it would collide.
OPENCLAW_VMID=

# --- backfilled 2026-09-12, previously flagged as drift -------------------

# VNC password for the view-only public feed (scripts/install_df.py vnc*).
# The public feed is deliberately -viewonly; this is not a security boundary,
# and the admin channel is gated by Cloudflare Access instead.
# UNUSED on VM 103 as of 2026-09-14: both units run x11vnc -nopw, so setting
# this changes nothing unless you reinstall with a password. Left here because
# `install_df.py vnc --password` still honours it. The live value was removed
# from .env and the stale /opt/df/vnc/passwd deleted that day.
DF_VNC_PASSWORD=

# Second Cloudflare Tunnel connector token, for the authenticated
# personal-control (real mouse/keyboard) channel, kept separate from the
# public view-only tunnel above so the two can be revoked independently.
CLOUDFLARE_TUNNEL_TOKEN_ADMIN=

# Model provider keys. Only needed by the eval harnesses under evals/, not by
# provisioning. DeepSeek is the compliance harness's default provider;
# --provider anthropic is opt-in, because an Opus sweep cost $9-13 in one
# afternoon (decisions/DECISIONS.md 2026-09-11).
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# VMIDs. The template is cloned to produce the working VM; keeping the IDs
# explicit avoids the scripts guessing.
DF_TEMPLATE_VMID=
RELAY_TEMPLATE_VMID=
RELAY_VMID=

# The relay VM's address, CIDR form, static via ipconfig0 at clone time for
# the same reason as the other sandbox guests: these VMs do not hold a
# constant MAC across rebuilds, so a MAC-keyed DHCP reservation would not
# survive one. Allocate in home-lab/inventory/ips.yaml before assigning.
RELAY_VM_IP=

# Local path to a legitimately-owned Steam install of Dwarf Fortress, used by
# scripts/install_df.py graphics to transplant the official graphics modules
# onto the VM over scp. Never copied through this repo's git tree. Ten module
# folders are needed; two of them do not share the _graphics suffix.
DF_GRAPHICS_SOURCE=

# --- MCP server: per-role bearer tokens (mcp/auth.py) ---------------------
# docs/AGENT-ARCHITECTURE.md §13: role identity must be a credential, not a
# claim, so each role that will call the MCP server needs its own token,
# generated out of band (no rotation tooling in this repo; a one-off on-VM
# rotation is recorded in decisions/DECISIONS.md 2026-09-15) and pasted
# in by hand, the same way PVE_TOKEN_SECRET already is. One variable per
# ENABLED role in agents/ROSTER.yaml (mcp/roles.py refuses to load a token
# for a role that is not enabled, or a token shorter than
# mcp.auth.MIN_TOKEN_LENGTH). Never commit a real value here -- this file is
# the tracked template; real tokens go only in the gitignored .env.
MCP_ROLE_TOKEN_OVERSEER=
MCP_ROLE_TOKEN_ARCHITECT=
MCP_ROLE_TOKEN_CONSULTANT=

# --- MCP server: transport config (dfmcp/server.py) -----------------------
# docs/AGENT-ARCHITECTURE.md §13: the bind address is tailnet-only and must
# be explicit -- dfmcp.server.ServerConfig has NO default for this and
# refuses to start without it, and separately refuses the literal value
# 0.0.0.0 outright. Set this to VM 103's own tailnet address once the
# server is actually deployed there; leave blank until then.
MCP_SERVER_BIND_HOST=

# Optional; defaults to 8443 if unset.
MCP_SERVER_BIND_PORT=

# Optional; default to DFHack's own defaults (127.0.0.1:5000) if unset,
# matching dfmcp.dfhack_client's own default host/port -- only needed here
# if DFHack is reached through something other than the plain loopback RPC
# socket (e.g. a non-default RunCommand port).
MCP_SERVER_DFHACK_HOST=
MCP_SERVER_DFHACK_PORT=

# Optional; defaults to 4. Caps how much of one cycle's reads can land in a
# single DFHack suspend window (dfmcp/dfhack_client.py's
# DFHackConnectionPool) -- size to the largest batch of reads a single
# calling cycle actually wants to fire, not left at the default by default.
MCP_SERVER_POOL_SIZE=

# Required, no default: the absolute path to dfqueue's SQLite file
# (dfmcp.queue_tools' queue.propose/pass/rule/pending -- dfmcp/server.py's
# ServerConfig refuses to start without it). Deliberately NOT the in-tree
# default dfqueue/<fort>.sqlite3, which sits inside the code checkout: a
# code redeploy on VM 103 must never be able to clobber live queue data by
# resolving to a path relative to wherever the checkout happens to be. Point
# this somewhere outside the repo checkout on VM 103, e.g.
# /var/lib/dfmcp/<fort>.sqlite3 (path illustrative -- see Phase B's deploy
# checklist for the real path once chosen).
MCP_SERVER_QUEUE_DB=

# Path to doctrine/seed.yaml, read by the native `doctrine.get` tool
# (dfmcp/doctrine_tools.py). Optional: defaults to the in-tree
# doctrine/seed.yaml, which is safe because the file is checked in and travels
# with the deployed code. Read-only, and re-read on every call, so a merged
# doctrine edit goes live without a server restart. Set it only if the server
# runs from a tree where doctrine/ is somewhere else.
MCP_SERVER_DOCTRINE_PATH=
