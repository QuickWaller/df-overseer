# Copy to `.env` in the repo root and fill in. infra/local.* is gitignored.
# This repo is PUBLIC — never commit real values.

# Proxmox host on the tailnet (e.g. pve-host.tailXXXX.ts.net or 100.x.y.z)
PVE_HOST=
PVE_PORT=8006

# Node name as Proxmox knows it (`pvesh get /nodes`)
PVE_NODE=

# API token. Format: user@realm!tokenid. This project's is
# svc-<project>-sandbox@pve!build. The secret is shown ONCE at creation and
# no automation may copy it; paste it here by hand.
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=

# Resource pool the token is scoped to, named <project>-sandbox by
# convention. It must not be able to see anything outside this pool.
# Required: pve.py raises on startup if unset, rather than defaulting to a
# pool that may no longer exist and failing later in a way that reads like a
# permissions error.
PVE_POOL=

# Storage backing the DF VM's disk and snapshots, dedicated to this project's
# pool so it shares no ACL boundary with any other project's disks.
# Required, for the same reason as PVE_POOL above.
PVE_STORAGE=

# VMID of the Dwarf Fortress VM, once created
DF_VMID=

# The address the DF VM is assigned at clone time (scripts/provision_vm.py
# clone writes it into ipconfig0). Must be CIDR, e.g. 192.168.1.240/24, and
# outside your router's DHCP pool. Required for `clone`; also the address
# scripts/install_df.py SSHes to, in preference to asking the guest agent.
DF_VM_IP=

# Optional. Gateway for the address above; defaults to .1 of the same /24,
# which is right on essentially every home network and wrong loudly rather
# than silently if it is not.
DF_GW=

# Optional. Nameserver for the address above; defaults to DF_GW. A statically
# addressed guest is not handed a resolver the way a DHCP one is, so without
# this the guest boots with no DNS and the first apt-get fails in a way that
# reads as a network fault rather than a missing setting.
DF_DNS=

# Cloud-init user on the DF VM; the account DF runs as and the one
# scripts/install_df.py SSHes in as. Defaults to 'df'.
DF_CIUSER=df

# Proxmox uses a self-signed cert by default. Set to the CA path if you
# have one, or "false" to skip verification (tailnet-only, acceptable).
PVE_TLS_VERIFY=false

# SSH keypair used for the DF VM. Paths only — never paste key material here.
# Generate a dedicated one:
#   ssh-keygen -t ed25519 -f ~/.ssh/df_overseer_ed25519 -N "" -C "df-overseer"
# On Windows, `chmod 600` is a no-op on NTFS; restrict it with:
#   icacls <path> /inheritance:r /grant:r "$(whoami):R"
DF_SSH_KEY=
DF_SSH_PUBKEY=

# NOTE: the drift this file used to flag (DF_VNC_PASSWORD, the RELAY_* keys,
# ANTHROPIC_API_KEY) is backfilled as of 2026-09-12, along with the other keys
# a diff against the live .env found missing. Verified by comparing key NAMES
# only, never values. If you add a key to .env, add an empty counterpart here.

# Cloudflare Tunnel connector token (scripts/provision_relay.py's
# 'cloudflared' subcommand), from the Zero Trust dashboard: Networks ->
# Tunnels -> create a tunnel -> copy the connector token shown for the
# dashboard-managed (token-based) install flow. Leave blank until you have
# one — 'cloudflared' installs fine without it and only skips the
# 'service install' step.
CLOUDFLARE_TUNNEL_TOKEN=

# --- openclaw agent-host VM (planned, not yet provisioned) ---------------
# The address for the VM that runs `openclaw`, the agent host that drives the
# fortress. It lives on its own VM rather than sharing the relay, because it
# holds provider API credentials and write authority over the fort while the
# relay is the most exposed surface in the estate. See
# docs/AGENT-ARCHITECTURE.md section 13 for the topology and why the MCP
# server stays on the DF VM instead.
#
# Must be CIDR, and assigned statically via ipconfig0 at clone time rather
# than through a MAC-keyed DHCP reservation: these sandbox VMs do not hold a
# constant MAC across rebuilds, so a MAC-keyed reservation would not survive
# one. Allocate the address in home-lab/inventory/ips.yaml BEFORE assigning
# it; that file is an allocation registry, consult-before-assign.
OPENCLAW_VM_IP=

# The agent host's vmid, set once the clone exists. Pass the address to
# `provision_vm.py clone` with --ip-var OPENCLAW_VM_IP: the default is
# DF_VM_IP, which is the running fort, and cloning onto it would collide.
OPENCLAW_VMID=

# The absolute path on VM 106 where this repo's agents/ and conductor/ trees
# are checked out (infra/deploy-manifest.yaml's vm106-agents and
# vm106-conductor targets). Not a secret, but not hardcoded in the manifest
# either: scripts/vm-ssh.sh's own address-leak scrubber masks any
# `df-[a-z0-9-]+`-shaped string in its output, which this checkout's likely
# name matches (the same false positive docs/DRIFT-AUDIT-2026-09-28.md hit on
# Lua script filenames), so there is no way to read it back over vm-ssh.sh and
# print it in a committed file even though it identifies no host. Set by hand
# once (`scripts/vm-ssh.sh openclaw 'stat -c %n /opt/*/agents/ROSTER.yaml'`,
# then strip the trailing `/agents/ROSTER.yaml`).
OPENCLAW_CHECKOUT_ROOT=

# --- backfilled 2026-09-12, previously flagged as drift -------------------

# VNC password for the view-only public feed (scripts/install_df.py vnc*).
# The public feed is deliberately -viewonly; this is not a security boundary,
# and the admin channel is gated by Cloudflare Access instead.
# UNUSED on VM 103 as of 2026-09-14: both units run x11vnc -nopw, so setting
# this changes nothing unless you reinstall with a password. Left here because
# `install_df.py vnc --password` still honours it. The live value was removed
# from .env and the stale /opt/df/vnc/passwd deleted that day.
DF_VNC_PASSWORD=

# Second Cloudflare Tunnel connector token, for the authenticated
# personal-control (real mouse/keyboard) channel, kept separate from the
# public view-only tunnel above so the two can be revoked independently.
CLOUDFLARE_TUNNEL_TOKEN_ADMIN=

# Model provider keys. Only needed by the eval harnesses under evals/, not by
# provisioning. DeepSeek is the compliance harness's default provider;
# --provider anthropic is opt-in, because an Opus sweep cost $9-13 in one
# afternoon (decisions/DECISIONS.md 2026-09-11).
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# VMIDs. The template is cloned to produce the working VM; keeping the IDs
# explicit avoids the scripts guessing.
DF_TEMPLATE_VMID=
RELAY_TEMPLATE_VMID=
RELAY_VMID=

# The relay VM's address, CIDR form, static via ipconfig0 at clone time for
# the same reason as the other sandbox guests: these VMs do not hold a
# constant MAC across rebuilds, so a MAC-keyed DHCP reservation would not
# survive one. Allocate in home-lab/inventory/ips.yaml before assigning.
RELAY_VM_IP=

# Local path to a legitimately-owned Steam install of Dwarf Fortress, used by
# scripts/install_df.py graphics to transplant the official graphics modules
# onto the VM over scp. Never copied through this repo's git tree. Ten module
# folders are needed; two of them do not share the _graphics suffix.
DF_GRAPHICS_SOURCE=

# --- MCP server: per-role bearer tokens (mcp/auth.py) ---------------------
# docs/AGENT-ARCHITECTURE.md §13: role identity must be a credential, not a
# claim, so each role that will call the MCP server needs its own token,
# generated out of band (no rotation tooling in this repo; a one-off on-VM
# rotation is recorded in decisions/DECISIONS.md 2026-09-15) and pasted
# in by hand, the same way PVE_TOKEN_SECRET already is. One variable per
# ENABLED role in agents/ROSTER.yaml (mcp/roles.py refuses to load a token
# for a role that is not enabled, or a token shorter than
# mcp.auth.MIN_TOKEN_LENGTH). Never commit a real value here -- this file is
# the tracked template; real tokens go only in the gitignored .env.
MCP_ROLE_TOKEN_OVERSEER=
MCP_ROLE_TOKEN_ARCHITECT=
MCP_ROLE_TOKEN_CONSULTANT=
# Added handoffs/2026-09-22-loop-queue-quartermaster.md; genuinely missing
# until handoffs/2026-09-22-loop-conductor-fixes.md item 5 flagged and added
# it. agents/quartermaster/ is enabled by that same stream's work, though
# agents/ROSTER.yaml itself stays enabled: false until the orchestrator
# flips it at merge (that stream's own note) -- this placeholder line is
# ready either way, same "never commit a real value" convention as every
# other MCP_ROLE_TOKEN_* line here.
MCP_ROLE_TOKEN_QUARTERMASTER=
# Added handoffs/2026-10-07-planner-p1a.md. LEAVE UNSET until the planner is
# `enabled: true` in agents/ROSTER.yaml (stage P1b): dfmcp/auth.py refuses a
# token whose role is not enabled on the roster, so setting it early stops the
# server starting. Then issue it like the others (never commit a value, and add
# a row to the gitignored secrets rotation list: name, why, when, where).
MCP_ROLE_TOKEN_PLANNER=
# Added handoffs/2026-09-22-loop-clock-conductor-role.md: held ONLY by the
# conductor service (a later stream), never pasted into an agent's own
# credential store -- this role is code, never a model (agents/conductor/role.md).
MCP_ROLE_TOKEN_CONDUCTOR=

# --- MCP server: transport config (dfmcp/server.py) -----------------------
# docs/AGENT-ARCHITECTURE.md §13: the bind address is tailnet-only and must
# be explicit -- dfmcp.server.ServerConfig has NO default for this and
# refuses to start without it, and separately refuses the literal value
# 0.0.0.0 outright. Set this to VM 103's own tailnet address once the
# server is actually deployed there; leave blank until then.
MCP_SERVER_BIND_HOST=

# Optional; defaults to 8443 if unset.
MCP_SERVER_BIND_PORT=

# Optional; default to DFHack's own defaults (127.0.0.1:5000) if unset,
# matching dfmcp.dfhack_client's own default host/port -- only needed here
# if DFHack is reached through something other than the plain loopback RPC
# socket (e.g. a non-default RunCommand port).
MCP_SERVER_DFHACK_HOST=
MCP_SERVER_DFHACK_PORT=

# Optional; defaults to 4. Caps how much of one cycle's reads can land in a
# single DFHack suspend window (dfmcp/dfhack_client.py's
# DFHackConnectionPool) -- size to the largest batch of reads a single
# calling cycle actually wants to fire, not left at the default by default.
MCP_SERVER_POOL_SIZE=

# Required, no default: the absolute path to dfqueue's SQLite file
# (dfmcp.queue_tools' queue.propose/pass/rule/pending -- dfmcp/server.py's
# ServerConfig refuses to start without it). Deliberately NOT the in-tree
# default dfqueue/<fort>.sqlite3, which sits inside the code checkout: a
# code redeploy on VM 103 must never be able to clobber live queue data by
# resolving to a path relative to wherever the checkout happens to be. Point
# this somewhere outside the repo checkout on VM 103, e.g.
# /var/lib/dfmcp/<fort>.sqlite3 (path illustrative -- see Phase B's deploy
# checklist for the real path once chosen).
MCP_SERVER_QUEUE_DB=

# Path to doctrine/seed.yaml, read by the native `doctrine.get` tool
# (dfmcp/doctrine_tools.py). Optional: defaults to the in-tree
# doctrine/seed.yaml, which is safe because the file is checked in and travels
# with the deployed code. Read-only, and re-read on every call, so a merged
# doctrine edit goes live without a server restart. Set it only if the server
# runs from a tree where doctrine/ is somewhere else.
MCP_SERVER_DOCTRINE_PATH=

# Path to the dfseries SQLite database, read by the six native `series.*`
# tools (dfmcp/series_tools.py) that let an agent see the fort's own
# recorded history (docs/TIMESERIES.md). Optional: defaults to
# /var/lib/dfseries/uniboslan.series.sqlite3, the path
# handoffs/2026-09-19-dfseries-auto-import.md's deploy chose (an absolute
# path outside the code checkout, safe as a real default the same way
# MCP_SERVER_DOCTRINE_PATH's in-tree default is -- unlike
# MCP_SERVER_QUEUE_DB, a code redeploy resolving a relative path can never
# land on an absolute one by accident). The server refuses to start serving
# a series.* call against a path that does not exist rather than silently
# reporting an empty history, so this only needs setting if the server runs
# against a differently-named fort or a non-default install layout.
MCP_SERVER_SERIES_DB=

# Brave Search API key for the Consultant's web.search tool
# (dfmcp/knowledge_tools.py). Real value already lives in this
# workstation's .env; this line documents its existence in the tracked
# template, matching the existing "backfilled" convention for other keys
# this file used to be missing. Get a key at https://brave.com/search/api/.
BRAVE_SEARCH_API_KEY=

# Path to the local Dwarf Fortress Wiki snapshot JSON
# (scripts/build_wiki_snapshot.py builds it; dfmcp/knowledge_tools.py's
# knowledge.wiki_lookup reads it). No safe default: this stream did not
# build one. Optional -- knowledge.wiki_lookup fails loudly, naming this
# variable, until it is set and the file exists.
MCP_SERVER_WIKI_SNAPSHOT=

# Root directory of the installed DFHack build's own scripts/docs/Lua,
# read by dfmcp.knowledge_tools' dfhack.source_search/dfhack.source_read.
# On VM 103, source-derived (not live-confirmed) as /opt/df/game/hack --
# see handoffs/2026-09-22-loop-consultant-retrieval.md's Result section
# for how that path was derived and what would confirm it. Optional --
# both tools fail loudly, naming this variable, until it is set.
MCP_SERVER_DFHACK_SOURCE_ROOT=

# Telegram: the user's private line to the Overseer, plus system alarms
# (register 2026-10-01). Token from @BotFather; never paste it in a chat.
# Only messages from USER_TELEGRAM_ID are ever accepted.
TELEGRAM_BOT_TOKEN=
USER_TELEGRAM_ID=

# --- stream page publisher (scripts/stream_publisher.py, slice S1 -------
# handoffs/2026-10-01-stream-page-s1-prep.md). Runs on VM 103, read-only
# against the live queue, pushing to the relay over a SECOND, directory-
# restricted SSH key (infra/stream-publisher-push-key-authorized-keys.example
# is the relay-side half; never reuse any other key this project has).
# UNDEPLOYED as of this handoff -- see
# infra/stream-publisher.service.example's own header for the full deploy
# checklist. Every value below is required only once the relay side is
# actually provisioned; with none of the *_RELAY_* variables set, the
# publisher still runs safely, writing its local staging files and pushing
# nothing (`"reason": "no_relay_configured"`).

# Absolute path to the live queue SQLite file, OUTSIDE the code checkout --
# same reasoning as MCP_SERVER_QUEUE_DB above: a code redeploy must never
# resolve a relative path onto live queue data. No default; the publisher
# refuses to start without it.
STREAM_PUBLISHER_DB=

# Absolute path to a local staging directory this unit can write (where
# data/public/ and data/operator/ are built before being pushed). No
# default; the publisher refuses to start without it. Recommended: under
# systemd's own StateDirectory=stream-publisher
# (infra/stream-publisher.service.example), e.g.
# /var/lib/stream-publisher/stage.
STREAM_PUBLISHER_STAGING_DIR=

# Optional. If this file exists, NOTHING is pushed to the relay this cycle
# -- the fast, "touch/rm to stop everything" kill switch (design §4.6's
# layer 2 cousin; this one stops BOTH sides, not just public). Recommended
# under the same StateDirectory, e.g. /var/lib/stream-publisher/STOP.
STREAM_PUBLISHER_KILL_SWITCH_FILE=

# Optional, defaults to true. Set to false to stop and CLEAR only the
# public side (design §4.6 layer 2) while the operator side keeps running --
# the slower, deliberate switch, meant to be flipped by hand, not an
# emergency file touch.
STREAM_PUBLISHER_PUBLIC_ENABLED=

# Optional. Seconds between forced pushes even with nothing changed
# (defaults to 60 -- design §4.3's "a heartbeat rewrite of head.json every
# minute") and seconds between cycles when run in the script's own loop
# mode rather than under stream-publisher.timer.example (defaults to 5,
# design §4.3's own push cadence). The timer's OnUnitActiveSec= is the real
# cadence control once deployed; this only matters for `--once`-less manual
# runs.
STREAM_PUBLISHER_HEARTBEAT_SECONDS=
STREAM_PUBLISHER_LOOP_SECONDS=

# Optional. This fort's id for the multi-fort data layout
# (`<out>/forts/<fort-id>/...`, register 2026-10-02 "plan for more than one
# fort") -- defaults to STREAM_PUBLISHER_DB's own file stem
# (/var/lib/dfqueue/Uniboslan.sqlite3 -> Uniboslan) when unset, the same
# convention scripts/export_stream_feed.py's own --fort-id uses. Set this
# explicitly only if the queue file's name should not double as the fort id.
STREAM_PUBLISHER_FORT_ID=

# Optional. This fort's display name for forts.json (default: Ragwind, the
# one real fort this repo automates today) and status, "live" or "lost"
# (default: live).
STREAM_PUBLISHER_FORT_NAME=
STREAM_PUBLISHER_FORT_STATUS=

# Optional. A live gotcha-store SQLite file (read-only; dfqueue.site_data.
# load_gotchas_readonly opens it with mode=ro, same as STREAM_PUBLISHER_DB
# above, and never writes to it), for the Agents/Tools pages' gotchas.json
# (handoffs/2026-10-02-site-agents-tools.md). Omit for an honest, empty
# gotchas.json rather than inventing entries.
STREAM_PUBLISHER_GOTCHAS_DB=

# The two rsync push targets -- all four of PUBLIC_RELAY_{HOST,USER,PATH,
# SSH_KEY} must be set together, or none at all (a half-configured relay is
# refused, never silently partial). HOST is the relay's own address;
# SSH_KEY is the path to the PRIVATE half of the restricted push key
# generated per infra/stream-publisher-push-key-authorized-keys.example
# (e.g. /etc/stream-publisher/relay_push_ed25519), never any other key.
STREAM_PUBLISHER_PUBLIC_RELAY_HOST=
STREAM_PUBLISHER_PUBLIC_RELAY_USER=
STREAM_PUBLISHER_PUBLIC_RELAY_PATH=
STREAM_PUBLISHER_PUBLIC_RELAY_SSH_KEY=

# Same four fields, for the operator projection's own push target. Can
# share the same HOST/USER/SSH_KEY as the public side above (one
# directory-restricted key covers the shared parent of both, per that
# example file's own note) with only PATH differing.
STREAM_PUBLISHER_OPERATOR_RELAY_HOST=
STREAM_PUBLISHER_OPERATOR_RELAY_USER=
STREAM_PUBLISHER_OPERATOR_RELAY_PATH=
STREAM_PUBLISHER_OPERATOR_RELAY_SSH_KEY=
