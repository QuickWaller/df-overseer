# The relay's Caddy config for the stream page, as deployed 2026-10-01
# (evals/live/2026-10-01-stream-page-s1-deploy/README.md). Replace the
# CHANGEME ports with the two noVNC (websockify) services' loopback ports.
#
# Each hostname's Cloudflare tunnel points at one of these two sites. The
# page is the front door: "/" is the stream page with the live view
# embedded; "/view" is the bare viewer; everything else passes through to
# noVNC unchanged, so its own files (vnc.html, app/, core/, websockify)
# keep working. The page's own files have names noVNC does not use.
#
# Loopback only: a site address alone does not limit the listener, so each
# site carries an explicit `bind 127.0.0.1` (found live: without it Caddy
# listened on every interface). The public site has no route to the
# operator data at all, by construction.
#
# Cache-Control: Cloudflare cached an empty app.js during the switch-over
# and served it from its edge (a white page). The page revalidates; the
# data is never cached; asset links carry a ?v= version.
{
	admin localhost:2019
	auto_https off
}

http://127.0.0.1:8090 {
	bind 127.0.0.1
	@page path / /index.html /app.js /style.css
	handle @page {
		header Cache-Control "no-cache"
		rewrite / /index.html
		root * /srv/stream/web-public
		file_server
	}
	handle_path /data/public/* {
		header Cache-Control "no-store"
		root * /srv/stream/data/public
		file_server
	}
	handle /view {
		redir * /vnc.html?autoconnect=true&resize=scale 302
	}
	handle /stream* {
		redir * / 302
	}
	handle {
		reverse_proxy 127.0.0.1:CHANGEME_WEBSOCKIFY_PUBLIC_PORT
	}
}

http://127.0.0.1:8091 {
	bind 127.0.0.1
	@page path / /operator.html /index.html /app.js /style.css
	handle @page {
		header Cache-Control "no-cache"
		rewrite / /operator.html
		root * /srv/stream/web-operator
		file_server
	}
	handle_path /data/public/* {
		header Cache-Control "no-store"
		root * /srv/stream/data/public
		file_server
	}
	handle_path /data/operator/* {
		header Cache-Control "no-store"
		root * /srv/stream/data/operator
		file_server
	}
	handle /view {
		redir * /vnc.html?autoconnect=true&resize=scale 302
	}
	handle /stream* {
		redir * / 302
	}
	handle {
		reverse_proxy 127.0.0.1:CHANGEME_WEBSOCKIFY_CONTROL_PORT
	}
}
