# UNDEPLOYED template for the Gateway's NON-secret env file on VM 106
# (infra/units/openclaw/openclaw-gateway.service, EnvironmentFile= and a
# docker --env-file). Copy to /opt/openclaw/gateway/gateway.env, fill in,
# never commit the filled-in copy. This repo is PUBLIC: placeholders only.
#
# Secrets do NOT go here. The Gateway token lives in its own 0600 file,
# /opt/openclaw/secrets/gateway-token.env, one line: OPENCLAW_GATEWAY_TOKEN=<value>.
# The DeepSeek key and the role tokens (DF_MCP_TOKEN_<ROLE>) come from the
# existing /opt/openclaw/secrets/openclaw_secrets.env.

# Loopback port the Gateway listens on.
OPENCLAW_GATEWAY_PORT=18789

# The openclaw image, pinned BY DIGEST (never :latest).
OPENCLAW_GATEWAY_IMAGE=ghcr.io/openclaw/openclaw@sha256:<64 hex digits>

# The dfmcp server URL the config template's mcp.servers entries use,
# the same value as CONDUCTOR_MCP_URL.
OPENCLAW_MCP_URL=http://<vm-103-tailnet-addr>:8443/mcp
