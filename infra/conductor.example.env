# UNDEPLOYED template for the conductor service's own env file on VM 106
# (see conductor.service.example, this directory, EnvironmentFile=).
# Distinct from this repo's root .env (infra/local.example.env): that file
# is this WORKSTATION's own template for provisioning and the MCP server's
# role tokens; this one is what VM 106's conductor.service actually reads.
# Copy to e.g. /CHANGEME/conductor.env on VM 106, fill in, never commit the
# filled-in copy. This repo is PUBLIC -- placeholders only below.
#
# conductor/config.py's own ConfigError names exactly which of these is
# missing at startup; nothing here has a default that could silently point
# at the wrong host, path or secret (same discipline dfmcp.server.
# ServerConfig already applies to bind_host/queue_db).

# --- dfmcp connection (VM 103) ---------------------------------------------

# The URL this repo's dfmcp-server.service actually serves, once deployed --
# same value that would go in an openclaw pinned-config.json's mcp.servers
# entry. Tailnet address, never a public one (docs/AGENT-ARCHITECTURE.md §13).
CONDUCTOR_MCP_URL=http://<vm-103-tailnet-addr>:8443/mcp

# The conductor role's OWN token (agents/conductor/tools.yaml). Held ONLY by
# this service -- never pasted into any agent's own pinned config or
# workspace, per agents/conductor/role.md. Minted the same way every other
# MCP_ROLE_TOKEN_<ROLE> is (infra/local.example.env's own section);
# MCP_ROLE_TOKEN_CONDUCTOR already has a placeholder line there too, added
# by the clock/conductor-role stream this one builds on.
MCP_ROLE_TOKEN_CONDUCTOR=

# --- openclaw / docker launch (conductor/runner.py) ------------------------

# One <role>.json per role this MVP launches (architect, quartermaster,
# consultant, overseer), each carrying that role's own
# agents.defaults.systemAgent.agentId, MCP entry and tools.allow -- see
# conductor/runner.py's own module docstring for why one config per role,
# not one shared multi-agent config selected by a CLI flag.
CONDUCTOR_PINNED_CONFIG_DIR=/CHANGEME/conductor/pinned-configs

# Bind-mounted read-write onto every launched container's /home/node/
# .openclaw -- the same directory every real run so far has used
# (/opt/openclaw/config), so the persisted DeepSeek auth profile and plugin
# registry (research/2026-09-15-openclaw-secret-storage.md,
# research/2026-09-18-openclaw-capabilities.md) are shared, not rebuilt
# per launch.
CONDUCTOR_OPENCLAW_STATE_DIR=/opt/openclaw/config

# Parent directory for each role's ephemeral <role>-workspace/SOUL.md
# (conductor/runner.py's write_soul/cleanup_workspace). Matches every real
# run's own workspace path convention (e.g. /opt/openclaw/overseer-workspace).
CONDUCTOR_WORKSPACE_ROOT=/opt/openclaw

# Passed to every `docker run` as --env-file. This service's own process
# NEVER reads this file's contents (conductor/runner.py's own docstring) --
# only the path is used. Same file every real run so far has used:
# /opt/openclaw/secrets/openclaw_secrets.env.
CONDUCTOR_SECRETS_ENV_FILE=/opt/openclaw/secrets/openclaw_secrets.env

# --- this service's own local state -----------------------------------------

# conductor/policy.yaml, or a copy of it -- checked into the repo, so the
# in-tree path is usually fine here (WorkingDirectory=/CHANGEME/df-automation
# in conductor.service.example): /CHANGEME/df-automation/conductor/policy.yaml.
CONDUCTOR_POLICY_PATH=/CHANGEME/df-automation/conductor/policy.yaml

# Per-role diff.since cursors (conductor/cursors.py) -- OUTSIDE the checkout,
# same "a code redeploy must never clobber live state" reasoning as
# dfmcp's own MCP_SERVER_QUEUE_DB.
CONDUCTOR_CURSOR_STORE_PATH=/var/lib/conductor/cursors.json

# The conductor's own runtime archive root (conductor/archive.py): each
# cycle's briefing, every role run's JSON envelope, cost and clock changes,
# plus the daily cost log. OUTSIDE the checkout for the same reason as
# CONDUCTOR_CURSOR_STORE_PATH. Matches this repo's own runtime/ .gitignore
# entry in shape, but this is the DEPLOY path, not the in-tree one.
CONDUCTOR_RUNTIME_ROOT=/var/lib/conductor/runtime

# The status JSON conductor/status.py writes every cycle (state, last
# cycle, clock level, latched tripwire).
CONDUCTOR_STATUS_PATH=/var/lib/conductor/status.json

# --- optional, with real defaults in conductor/config.py -------------------

# openclaw's own agent exec --help default (600s). Override per-deploy if a
# role's real cycle time (unmeasured this stream -- docs/AGENT-LOOP.md §7)
# turns out to need more.
CONDUCTOR_ROLE_TIMEOUT_SECONDS=600

# How long the conductor sleeps between cycles when nothing failed. Not the
# same as the FORT's own clock speed (base_fps/think_fps, conductor/
# policy.yaml) -- this is real wall-clock time between the conductor's own
# read/grade/triage passes.
CONDUCTOR_CYCLE_INTERVAL_SECONDS=60

# Per-role model override, e.g. CONDUCTOR_MODEL_OVERSEER=deepseek/deepseek-
# v4-pro (every live run so far has put the Overseer on the pro tier and
# every advisor on flash). Unset roles fall back to conductor/config.py's
# own DEFAULT_MODEL (deepseek/deepseek-v4-flash), matching docs/AGENT-LOOP.md
# §4's "DeepSeek for every role."
CONDUCTOR_MODEL_ARCHITECT=
CONDUCTOR_MODEL_QUARTERMASTER=
CONDUCTOR_MODEL_CONSULTANT=
CONDUCTOR_MODEL_OVERSEER=
